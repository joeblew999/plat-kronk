# LiveKit Configuration
# Run 'xplat task env:init' to generate .env with secure random secret
#
# For development: These defaults work out of the box
# For production: Run 'xplat task env:init' to generate unique secret

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-secret-here-min-32-chars
LIVEKIT_HOST=ws://localhost:7880
